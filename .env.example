# Backend only. Never use PUBLIC_ names for these settings.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
FEATHERLESS_API_KEY=
# Proposed model; run evidence:check-embeddings before deployment.
FEATHERLESS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
FEATHERLESS_BASE_URL=https://api.featherless.ai/v1
FEATHERLESS_EMBEDDING_BATCH_SIZE=32
EVIDENCE_CHUNK_SIZE=2400
EVIDENCE_CHUNK_OVERLAP=300
EVIDENCE_CHUNK_MIN_SIZE=400
EVIDENCE_DISCOVERY_OVERLAP_DAYS=7
EVIDENCE_RECHECK_INTERVAL_DAYS=7
EVIDENCE_MAX_ITEMS_PER_PROVIDER=20
EVIDENCE_MAX_PAGES_PER_PROVIDER=10
EVIDENCE_RETRIEVAL_MAX_CHUNKS_PER_SOURCE=2
# Generative assessment, backend only. Model availability depends on provider plan.
CLIMATE_ASSESSMENT_MODEL=Qwen/Qwen3-32B
CLIMATE_ASSESSMENT_TEMPERATURE=0.1
CLIMATE_ASSESSMENT_MAX_TOKENS=4000
CLIMATE_ASSESSMENT_TIMEOUT_MS=180000
CLIMATE_ASSESSMENT_ADMIN_TOKEN=
CLIMATE_ASSESSMENT_ALLOWED_ORIGINS=http://localhost:4321
# Public URL only; points to the EXISTING evidence Worker. No credentials.
PUBLIC_CLIMATE_ASSESSMENT_API_URL=http://localhost:8787
